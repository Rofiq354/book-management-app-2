<div class="container py-5 ms-5">
  <h1 class="mb-3">Halaman Dashboard</h1>
  <div class="row g-4 mt-5">
    <!-- Total Books -->
    <div class="col-md-6 col-lg-4">
      <div class="card-dashboard card-green">
        <button class="card-arrow border">↗</button>
        <h5 class="fw-normal">Total Books</h5>
        <h1 class="fw-bold my-3">70</h1>
        <span class="trend trend-light">+5 Naik seminggu yang lalu</span>
      </div>
    </div>
    <!-- Status Available -->
    <div class="col-md-6 col-lg-4">
      <div class="card-dashboard bg-white">
        <button class="card-arrow">↗</button>
        <h5 class="status">Status <span>Available</span></h5>
        <h1 class="fw-bold my-3">50</h1>
        <span class="trend trend-green">+5 Naik seminggu yang lalu</span>
      </div>
    </div>
  </div>
</div>

